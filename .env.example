# Copy to .env and set your Groq token before `docker compose up`.
# Create a token at https://console.groq.com/keys
LLM_API_KEY=gsk_replace_me
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_CHAT=gemma2-9b-it
# Optional stronger router model (documented alternative):
LLM_MODEL_ROUTER=gemma2-9b-it
# LLM_MODEL_ROUTER=llama-3.3-70b-versatile
