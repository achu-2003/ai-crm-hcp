# ─── Groq LLM (create your own token at https://console.groq.com/keys) ───
LLM_API_KEY=gsk_replace_me
LLM_BASE_URL=https://api.groq.com/openai/v1
# The assignment names gemma2-9b-it — but Groq has DECOMMISSIONED that model and
# every call now 400s with "model_decommissioned":
#   https://console.groq.com/docs/deprecations
# We therefore run the brief's own sanctioned alternative. This is config, not
# code: if Groq ever restores gemma2, flip these two lines back and nothing else
# changes.
LLM_MODEL_CHAT=llama-3.3-70b-versatile
LLM_MODEL_ROUTER=llama-3.3-70b-versatile
# Retired: LLM_MODEL_CHAT=gemma2-9b-it
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ─── Database (PostgreSQL) ───
# Create the DB once:  psql -U postgres -c "CREATE DATABASE crm;"
# Tables are created from the SQLAlchemy models on startup — no manual DDL.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/crm
# docker-compose sets this automatically to its own Postgres service:
# DATABASE_URL=postgresql+asyncpg://crm:crm@db:5432/crm

# ─── CORS (comma-separated origins for the React dev/preview servers) ───
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
