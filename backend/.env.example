# ─── Groq LLM (create your own token at https://console.groq.com/keys) ───
LLM_API_KEY=gsk_replace_me
LLM_BASE_URL=https://api.groq.com/openai/v1
# Mandatory model for this assignment:
LLM_MODEL_CHAT=gemma2-9b-it
# Router node can optionally use a stronger model for tool selection.
# Falls back to LLM_MODEL_CHAT if left equal. Documented alternative:
LLM_MODEL_ROUTER=gemma2-9b-it
# LLM_MODEL_ROUTER=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ─── Database ───
# Zero-install local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./crm.db
# Postgres (docker-compose sets this automatically):
# DATABASE_URL=postgresql+asyncpg://crm:crm@db:5432/crm

# ─── CORS (comma-separated origins for the React dev/preview servers) ───
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
